---
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  current?: 'work' | 'about' | 'writing';
}

const { current } = Astro.props;

const name = 'Tom McQuaid';

// Drop a PNG or GIF at public/images/wordmark.png (or .gif).
const wordmarkSrc = ['/images/wordmark.png', '/images/wordmark.gif'].find((src) =>
  fs.existsSync(path.join(process.cwd(), 'public', src.slice(1)))
);

const links = [
  { href: '/', id: 'work', label: 'work' },
  { href: '/about/', id: 'about', label: 'about' },
  { href: '/writing/', id: 'writing', label: 'writing' },
] as const;
---

<a class="site-header__name" href="/">
  {wordmarkSrc ? <img src={wordmarkSrc} alt={name} /> : name}
</a>
<nav class="site-header__nav" aria-label="Site">
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={current === link.id ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))
  }
</nav>
