---
import Card from './Card.astro';
import Visual from './Visual.astro';
import type { z } from 'astro:content';
import type { containedVisualBlock } from '../../schemas/blocks';

type Block = z.infer<typeof containedVisualBlock>;
interface Props extends Block {}

const { image, caption } = Astro.props;
---

<Card variant="contained" label={caption ?? image.alt}>
  <figure class="card__media">
    <Visual {...image} />
    {caption && (
      <figcaption
        style="margin-top: var(--space-sm); font-size: 0.875rem; color: var(--color-muted); text-align: center;"
      >
        {caption}
      </figcaption>
    )}
  </figure>
</Card>
