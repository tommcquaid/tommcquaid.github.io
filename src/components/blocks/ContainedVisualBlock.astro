---
import Card from './Card.astro';
import Visual from './Visual.astro';
import type { z } from 'astro:content';
import type { containedVisualBlock } from '../../schemas/blocks';

type Block = z.infer<typeof containedVisualBlock>;
interface Props extends Block {}

const { image, caption, background } = Astro.props;
---

<Card variant="contained" label={caption ?? image.alt} background={background}>
  <figure class="card__media">
    <Visual {...image} />
    {caption && (
      <figcaption class="card__caption">
        {caption}
      </figcaption>
    )}
  </figure>
</Card>
